                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.SentinelConceptualDomain"/>
                     <lowerValue xmi:id="cdi.ConceptualVariable-ownedAttribute-3-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-ownedAttribute-3-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <association xmi:idref="cdi.ConceptualVariable_takesSentinelConceptsFrom_SentinelConceptualDomain"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ConceptualVariable-ownedAttribute-4"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-ownedAttribute-4"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.SubstantiveConceptualDomain"/>
                     <lowerValue xmi:id="cdi.ConceptualVariable-ownedAttribute-4-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-ownedAttribute-4-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <association xmi:idref="cdi.ConceptualVariable_takesSubstantiveConceptsFrom_SubstantiveConceptualDomain"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ConceptualVariable-ownedAttribute-5"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-ownedAttribute-5"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.UnitType"/>
                     <lowerValue xmi:id="cdi.ConceptualVariable-ownedAttribute-5-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-ownedAttribute-5-lowerValue"

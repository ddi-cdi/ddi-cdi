                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.AgentInRole-role"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentInRole-role"
                                   xmi:type="uml:Property">
                     <name>role</name>
                     <type xmi:idref="cdi.PairedControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.AgentInRole-role-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentInRole-role-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.AgentInRole-role-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentInRole-role-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>

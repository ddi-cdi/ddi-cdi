                               xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="cdim.Structure-name-upperValue"
                               xmi:uuid="DDICDIModels#Structure-name-upperValue"
                               xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
               </ownedAttribute>

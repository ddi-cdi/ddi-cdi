                  <ownedAttribute xmi:id="cdi.Unit-ownedAttribute-6"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Unit-ownedAttribute-6"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.UnitType"/>
                     <lowerValue xmi:id="cdi.Unit-ownedAttribute-6-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Unit-ownedAttribute-6-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.Unit-ownedAttribute-6-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Unit-ownedAttribute-6-upperValue"

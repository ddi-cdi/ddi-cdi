                     <lowerValue xmi:id="cdi.ClassificationIndex-ownedAttribute-14-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationIndex-ownedAttribute-14-lowerValue"

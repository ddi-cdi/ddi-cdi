                              xmi:type="uml:Association">
               <ownedComment xmi:id="cdim.Sign_denotes_Signified-ownedComment"
                              xmi:uuid="DDICDIModels#Sign_denotes_Signified-ownedComment"
                              xmi:type="uml:Comment">
                  <body>Concept or object denoted by the signifier associated to the sign.</body>
                  <annotatedElement xmi:idref="cdim.Sign_denotes_Signified"/>
               </ownedComment>
               <name>Sign_denotes_Signified</name>
               <ownedEnd xmi:id="cdim.Sign_denotes_Signified-ownedEnd-Sign"

                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure_generates_RevisableDatum"
                                    xmi:type="uml:Association">
                     <ownedComment xmi:id="cdi.ScopedMeasure_generates_RevisableDatum-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure_generates_RevisableDatum-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Scoped measure generates one revisable datum.</body>
                        <annotatedElement xmi:idref="cdi.ScopedMeasure_generates_RevisableDatum"/>
                     </ownedComment>
                     <name>ScopedMeasure_generates_RevisableDatum</name>
                     <ownedEnd xmi:id="cdi.ScopedMeasure_generates_RevisableDatum-ownedEnd-ScopedMeasure"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure_generates_RevisableDatum-ownedEnd-ScopedMeasure"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ScopedMeasure"/>
                        <association xmi:idref="cdi.ScopedMeasure_generates_RevisableDatum"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.ScopedMeasure-ownedAttribute-5"/>
                     <memberEnd xmi:idref="cdi.generates-ownedEnd-ScopedMeasure"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionalDataSet"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataSet"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionalDataSet-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataSet-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Organized collection of multidimensional data. It is structured by a dimensional data structure.

Examples
==========
A dimensional dataset with Income values in each data point, where the dimensions organizing the data points are Sex and Marital Status.

Explanatory notes
===================
Similar to Structural N-Cube.</body>
                        <annotatedElement xmi:idref="cdi.DimensionalDataSet"/>
                     </ownedComment>
                     <name>DimensionalDataSet</name>
                     <generalization xmi:id="cdi.DimensionalDataSet-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataSet-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataSet"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.DimensionalDataSet-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataSet-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ScopedMeasure"/>
                        <lowerValue xmi:id="cdi.DimensionalDataSet-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataSet-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.DimensionalDataSet-ownedAttribute-1-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataSet-ownedAttribute-1-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.DimensionalDataSet_represents_ScopedMeasure"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionalDataStructure"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataStructure"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionalDataStructure-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataStructure-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Structure of a dimensional data set (organized collection of multidimensional data). It is described by dimension, measure and attribute components.

Examples
==========
The structure described by [City, Average Income, Total Population] where City is a dimension and Average Income and Total Population are measures.
</body>
                        <annotatedElement xmi:idref="cdi.DimensionalDataStructure"/>
                     </ownedComment>
                     <name>DimensionalDataStructure</name>
                     <generalization xmi:id="cdi.DimensionalDataStructure-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataStructure-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataStructure"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.DimensionalDataStructure-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataStructure-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.DimensionGroup"/>
                        <lowerValue xmi:id="cdi.DimensionalDataStructure-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataStructure-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.DimensionalDataStructure-ownedAttribute-1-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalDataStructure-ownedAttribute-1-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.DimensionalDataStructure_uses_DimensionGroup"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionalKey"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKey"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionalKey-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKey-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Collection of data instances that uniquely identify a collection of data points in a dimensional dataset.

Examples
==========
Collection of "male", "Ontario" and "married" strings in a dimensional dataset where data points are identified by Sex, Province and Marital Status dimensions.</body>
                        <annotatedElement xmi:idref="cdi.DimensionalKey"/>
                     </ownedComment>
                     <name>DimensionalKey</name>
                     <generalization xmi:id="cdi.DimensionalKey-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKey-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.Key"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionalKeyDefinition"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinition"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionalKeyDefinition-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinition-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Collection of concepts that uniquely defines a collection of data points in a dimensional dataset.

Examples
==========
Collection of [Male], [Ontario] and [Married] categories in a dimensional dataset where data points are defined by Sex, Province and Marital Status dimensions.</body>
                        <annotatedElement xmi:idref="cdi.DimensionalKeyDefinition"/>
                     </ownedComment>
                     <name>DimensionalKeyDefinition</name>
                     <generalization xmi:id="cdi.DimensionalKeyDefinition-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinition-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.KeyDefinition"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionalKeyDefinitionMember"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinitionMember"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionalKeyDefinitionMember-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinitionMember-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Single concept that is part of a dimensional key definition.

Examples
==========
The [Ontario] category in a dimensional dataset where data points are defined by Province and other dimensions.</body>
                        <annotatedElement xmi:idref="cdi.DimensionalKeyDefinitionMember"/>
                     </ownedComment>
                     <name>DimensionalKeyDefinitionMember</name>
                     <generalization xmi:id="cdi.DimensionalKeyDefinitionMember-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinitionMember-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.ConceptualValue"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.DimensionalKeyDefinitionMember-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinitionMember-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.DimensionalKeyMember"/>
                        <upperValue xmi:id="cdi.DimensionalKeyDefinitionMember-ownedAttribute-1-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyDefinitionMember-ownedAttribute-1-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.DimensionalKeyDefinitionMember_isRepresentedBy_DimensionalKeyMember"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionalKeyMember"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyMember"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionalKeyMember-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyMember-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Single data instance that is part of a dimensional key. 

Examples
==========
The "Ontario" string in a dimensional dataset where data points are identified by Province and other dimensions.


</body>
                        <annotatedElement xmi:idref="cdi.DimensionalKeyMember"/>
                     </ownedComment>
                     <name>DimensionalKeyMember</name>
                     <generalization xmi:id="cdi.DimensionalKeyMember-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyMember-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.KeyMember"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.DimensionalKeyMember-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionalKeyMember-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.CodeList"/>
                        <association xmi:idref="cdi.DimensionalKeyMember_hasValueFrom_CodeList"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DimensionGroup"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DimensionGroup-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Collection of dimensions that can be reused across multiple dimensional structures.

Examples
==========
Sex, Province and Marital Status is a common set of dimensions used across a variety of dimensional data structures and might need to be maintained separately.</body>
                        <annotatedElement xmi:idref="cdi.DimensionGroup"/>
                     </ownedComment>
                     <name>DimensionGroup</name>
                     <ownedAttribute xmi:id="cdi.DimensionGroup-identifier"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-identifier"
                                      xmi:type="uml:Property">
                        <name>identifier</name>
                        <type xmi:idref="cdi.Identifier"/>
                        <lowerValue xmi:id="cdi.DimensionGroup-identifier-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-identifier-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.DimensionGroup-name"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-name"
                                      xmi:type="uml:Property">
                        <name>name</name>
                        <type xmi:idref="cdi.ObjectName"/>
                        <lowerValue xmi:id="cdi.DimensionGroup-name-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-name-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.DimensionGroup-name-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-name-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.DimensionGroup-ownedAttribute-3"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-ownedAttribute-3"
                                      xmi:type="uml:Property">
                        <type xmi:idref="cdi.DimensionComponent"/>
                        <upperValue xmi:id="cdi.DimensionGroup-ownedAttribute-3-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DimensionGroup-ownedAttribute-3-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.DimensionComponent_has_DimensionGroup"/>
                        <aggregation>shared</aggregation>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.QualifiedMeasure"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#QualifiedMeasure"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.QualifiedMeasure-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#QualifiedMeasure-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
A measure having a specific production method. 

Examples
==========
Seasonally adjusted monthly income.
</body>
                        <annotatedElement xmi:idref="cdi.QualifiedMeasure"/>
                     </ownedComment>
                     <name>QualifiedMeasure</name>
                     <generalization xmi:id="cdi.QualifiedMeasure-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#QualifiedMeasure-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.MeasureComponent"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.QualifiedMeasure-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#QualifiedMeasure-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.MeasureComponent"/>
                        <lowerValue xmi:id="cdi.QualifiedMeasure-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#QualifiedMeasure-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.QualifiedMeasure_refines_MeasureComponent"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.RevisableDatum"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RevisableDatum"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.RevisableDatum-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RevisableDatum-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
A datum that can be qualified by a revision.

Examples
==========
The April datum for Income revised in June.

</body>
                        <annotatedElement xmi:idref="cdi.RevisableDatum"/>
                     </ownedComment>
                     <name>RevisableDatum</name>
                     <generalization xmi:id="cdi.RevisableDatum-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RevisableDatum-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.Datum"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.RevisableDatum-vintage"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RevisableDatum-vintage"
                                      xmi:type="uml:Property">
                        <name>vintage</name>
                        <type xmi:type="uml:PrimitiveType"
                               href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.RevisableDatum-ownedAttribute-2"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RevisableDatum-ownedAttribute-2"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.Revision"/>
                        <lowerValue xmi:id="cdi.RevisableDatum-ownedAttribute-2-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RevisableDatum-ownedAttribute-2-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.RevisableDatum_correspondsTo_Revision"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.Revision"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.Revision-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Algorithm applied to produce a revised datum.

Examples
==========
An adjustment to monthly employment numbers to adjust for errors (sampling or non-sampling) in the underlying data.

</body>
                        <annotatedElement xmi:idref="cdi.Revision"/>
                     </ownedComment>
                     <name>Revision</name>
                     <ownedAttribute xmi:id="cdi.Revision-algorithm"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-algorithm"
                                      xmi:type="uml:Property">
                        <name>algorithm</name>
                        <type xmi:type="uml:PrimitiveType"
                               href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
                        <lowerValue xmi:id="cdi.Revision-algorithm-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-algorithm-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.Revision-identifier"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-identifier"
                                      xmi:type="uml:Property">
                        <name>identifier</name>
                        <type xmi:idref="cdi.Identifier"/>
                        <lowerValue xmi:id="cdi.Revision-identifier-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-identifier-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.Revision-overview"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-overview"
                                      xmi:type="uml:Property">
                        <name>overview</name>
                        <type xmi:idref="cdi.InternationalString"/>
                        <lowerValue xmi:id="cdi.Revision-overview-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Revision-overview-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ScopedMeasure"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.ScopedMeasure-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
==========
A qualified measure whose domain is a universe as an aggregate, i.e. a measure with a specific production method applied to a specific cell in a cube.

Examples
========
Seasonally adjusted income for Single, Ontarians, Females.</body>
                        <annotatedElement xmi:idref="cdi.ScopedMeasure"/>
                     </ownedComment>
                     <name>ScopedMeasure</name>
                     <ownedAttribute xmi:id="cdi.ScopedMeasure-frequency"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-frequency"
                                      xmi:type="uml:Property">
                        <name>frequency</name>
                        <type xmi:idref="cdi.InternationalString"/>
                        <lowerValue xmi:id="cdi.ScopedMeasure-frequency-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-frequency-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.ScopedMeasure-identifier"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-identifier"
                                      xmi:type="uml:Property">
                        <name>identifier</name>
                        <type xmi:idref="cdi.Identifier"/>
                        <lowerValue xmi:id="cdi.ScopedMeasure-identifier-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-identifier-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.ScopedMeasure-ownedAttribute-3"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-ownedAttribute-3"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.DimensionalKeyDefinition"/>
                        <lowerValue xmi:id="cdi.ScopedMeasure-ownedAttribute-3-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-ownedAttribute-3-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.ScopedMeasure_circumscribes_DimensionalKeyDefinition"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.ScopedMeasure-ownedAttribute-4"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-ownedAttribute-4"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.QualifiedMeasure"/>
                        <lowerValue xmi:id="cdi.ScopedMeasure-ownedAttribute-4-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-ownedAttribute-4-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.ScopedMeasure_restricts_QualifiedMeasure"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.ScopedMeasure-ownedAttribute-5"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ScopedMeasure-ownedAttribute-5"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.RevisableDatum"/>
                        <association xmi:idref="cdi.ScopedMeasure_generates_RevisableDatum"/>
                     </ownedAttribute>
                  </packagedElement>
               </packagedElement>
               <packagedElement xmi:id="cdi.KeyValue"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValue"
                                 xmi:type="uml:Package">
                  <ownedComment xmi:id="cdi.KeyValue-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValue-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>This package contains classes which are used to define key-value data, as found in various types of no-SQL and "big data" systems and data warehouses.</body>
                     <annotatedElement xmi:idref="cdi.KeyValue"/>
                  </ownedComment>
                  <name>KeyValue</name>
                  <packagedElement xmi:id="cdi.InstanceKey_refersTo_ReferenceValue"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey_refersTo_ReferenceValue"
                                    xmi:type="uml:Association">
                     <name>InstanceKey_refersTo_ReferenceValue</name>
                     <ownedEnd xmi:id="cdi.InstanceKey_refersTo_ReferenceValue-ownedEnd-InstanceKey"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey_refersTo_ReferenceValue-ownedEnd-InstanceKey"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.InstanceKey"/>
                        <lowerValue xmi:id="cdi.InstanceKey_refersTo_ReferenceValue-ownedEnd-InstanceKey-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey_refersTo_ReferenceValue-ownedEnd-InstanceKey-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.InstanceKey_refersTo_ReferenceValue-ownedEnd-InstanceKey-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey_refersTo_ReferenceValue-ownedEnd-InstanceKey-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.InstanceKey_refersTo_ReferenceValue"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.InstanceKey-ownedAttribute-2"/>
                     <memberEnd xmi:idref="cdi.refersTo-ownedEnd-InstanceKey"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.MainKeyMember_hasValueFrom_SubstantiveValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember_hasValueFrom_SubstantiveValueDomain"
                                    xmi:type="uml:Association">
                     <name>MainKeyMember_hasValueFrom_SubstantiveValueDomain</name>
                     <ownedEnd xmi:id="cdi.MainKeyMember_hasValueFrom_SubstantiveValueDomain-ownedEnd-MainKeyMember"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember_hasValueFrom_SubstantiveValueDomain-ownedEnd-MainKeyMember"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.MainKeyMember"/>
                        <lowerValue xmi:id="cdi.MainKeyMember_hasValueFrom_SubstantiveValueDomain-ownedEnd-MainKeyMember-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember_hasValueFrom_SubstantiveValueDomain-ownedEnd-MainKeyMember-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.MainKeyMember_hasValueFrom_SubstantiveValueDomain-ownedEnd-MainKeyMember-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember_hasValueFrom_SubstantiveValueDomain-ownedEnd-MainKeyMember-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.MainKeyMember_hasValueFrom_SubstantiveValueDomain"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.MainKeyMember-ownedAttribute-1"/>
                     <memberEnd xmi:idref="cdi.hasValueFrom-ownedEnd-MainKeyMember"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ContextualComponent"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ContextualComponent"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.ContextualComponent-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ContextualComponent-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Encapsulates contextual information of the key-value datastore to provide a scope to the instance key. The instance key is unique within the scope.

Examples
==========
A partition, cluster name and any other key-value datastore organization information. 

Explanatory notes
===================
A key-value datastore can be organized into multiple contextual components. 
Other data structure components that are part of the instance key, e.g. identifier and dimension components, guarantee uniqueness only within the scope of a contextual component. 
Synthetic id components do guarantee global uniqueness, but they might complex to setup and maintain in many organizations. 
Contextual components provide a simple mechanism to achieve uniqueness within a single key-value datastore. 
When a key-value datastore is organized in contextual components, a contextual component prefix is added to the instance key to make it unique across the entire key-value datastore.</body>
                        <annotatedElement xmi:idref="cdi.ContextualComponent"/>
                     </ownedComment>
                     <name>ContextualComponent</name>
                     <generalization xmi:id="cdi.ContextualComponent-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ContextualComponent-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataStructureComponent"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.InstanceKey"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.InstanceKey-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Single-valued key representation produced from the merge of the representations of all key members and a descriptor. 

Examples
==========
The string "cluster:income_distribution:unitid:20:period:2020/02:income", where "cluster:income_distribution" is a key member based on a contextual component, "unitid:20" is based on an identifier component, "period:2020/02" is based on a component with a time role and "income" is based on a descriptor.


Explanatory notes
===================
For value strings, the merge is the string concatenation operation.
For other classes, an appropriate merge representation can be defined.</body>
                        <annotatedElement xmi:idref="cdi.InstanceKey"/>
                     </ownedComment>
                     <name>InstanceKey</name>
                     <generalization xmi:id="cdi.InstanceKey-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.Key"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.InstanceKey-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <type xmi:idref="cdi.InstanceValue"/>
                        <lowerValue xmi:id="cdi.InstanceKey-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.InstanceKey_has_InstanceValue"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.InstanceKey-ownedAttribute-2"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceKey-ownedAttribute-2"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceValue"/>
                        <association xmi:idref="cdi.InstanceKey_refersTo_ReferenceValue"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.KeyValueDataStore"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValueDataStore"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.KeyValueDataStore-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValueDataStore-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Organized collection of key-value data. It is structured by a key value structure.

Examples
==========
A unit key-value datastore where each instance key corresponds to a data point capturing a different characteristic of a unit.

Explanatory notes
===================
A key-value datastore is just a collection of key-value pairs, i.e. instance keys and reference values. 
Each instance key encodes all relevant information about the context, the unit of interest and the variable associated with the reference value of a given data point.</body>
                        <annotatedElement xmi:idref="cdi.KeyValueDataStore"/>
                     </ownedComment>
                     <name>KeyValueDataStore</name>
                     <generalization xmi:id="cdi.KeyValueDataStore-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValueDataStore-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataSet"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.KeyValueStructure"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValueStructure"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.KeyValueStructure-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValueStructure-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Structure of a key-value datastore (organized collection of key-value data). It is described by identifier, contextual, synthetic id, dimension, variable descriptor and variable value components.

Examples
==========
The structure described by [Income distribution, Unit id, Period, Income] where Income distribution is the contextual component, Unit id identifies a statistical unit, period is a effective period and Income is the variable of interest.
</body>
                        <annotatedElement xmi:idref="cdi.KeyValueStructure"/>
                     </ownedComment>
                     <name>KeyValueStructure</name>
                     <generalization xmi:id="cdi.KeyValueStructure-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#KeyValueStructure-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataStructure"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.MainKeyMember"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.MainKeyMember-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Identifies the unit of interest, either a statistical unit or a population, via identifier or dimension components, respectively, plus an optional contextual component. 
If neither identifier nor dimension components are present, then a synthetic id component is used. 

Examples
==========
The string "income_distribution:male:Ontario:married" in a dimensional key-value datastore, where instance key members are defined by context plus Sex, Province and Marital Status dimensions.
</body>
                        <annotatedElement xmi:idref="cdi.MainKeyMember"/>
                     </ownedComment>
                     <name>MainKeyMember</name>
                     <generalization xmi:id="cdi.MainKeyMember-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.KeyMember"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.MainKeyMember-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.SubstantiveValueDomain"/>
                        <lowerValue xmi:id="cdi.MainKeyMember-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#MainKeyMember-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.MainKeyMember_hasValueFrom_SubstantiveValueDomain"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.SyntheticIdComponent"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#SyntheticIdComponent"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.SyntheticIdComponent-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#SyntheticIdComponent-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Persistent and unique identifier (PIDs) to provide standarized, long-lasting identification. 

Examples
==========
UUIDs, GUIDs, DOIs, URNs or any other unique id generation framework.

Explanatory notes
===================
This PIDs either complement or replace identifier and dimension components. 
They complement them when there is a need for having a globally unique identifier as part of an instance key. They replace them when identier components are not available (e.g. after de-identification for confidentiality).</body>
                        <annotatedElement xmi:idref="cdi.SyntheticIdComponent"/>
                     </ownedComment>
                     <name>SyntheticIdComponent</name>
                     <generalization xmi:id="cdi.SyntheticIdComponent-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#SyntheticIdComponent-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataStructureComponent"/>
                     </generalization>
                  </packagedElement>
               </packagedElement>
               <packagedElement xmi:id="cdi.Long"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Long"
                                 xmi:type="uml:Package">
                  <ownedComment xmi:id="cdi.Long-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Long-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>This package contains classes used to define data in which observations are arranged in a stream or flow, as from sensors or entry into administrative registers, and may be understood as events over time, even if irregular. Long structures may also be generated by procedures like the R melt() function that transform a wide structure into a long structure. Some analysis procedures are designed to operate on long structures. Typically, the specific measures may vary across entries as they appear in the flow (measurements are entered in sequence, corresponding to different variables, often unpredictably), and the subject of the measure (the unit) may be repeated at several points in the stream.</body>
                     <annotatedElement xmi:idref="cdi.Long"/>
                  </ownedComment>
                  <name>Long</name>
                  <packagedElement xmi:id="cdi.Descriptor_refersTo_ReferenceValue"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_refersTo_ReferenceValue"
                                    xmi:type="uml:Association">
                     <name>Descriptor_refersTo_ReferenceValue</name>
                     <ownedEnd xmi:id="cdi.Descriptor_refersTo_ReferenceValue-ownedEnd-Descriptor"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_refersTo_ReferenceValue-ownedEnd-Descriptor"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.Descriptor"/>
                        <association xmi:idref="cdi.Descriptor_refersTo_ReferenceValue"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.Descriptor-ownedAttribute-1"/>
                     <memberEnd xmi:idref="cdi.refersTo-ownedEnd-Descriptor"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.Descriptor_identifies_ReferenceVariable"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_identifies_ReferenceVariable"
                                    xmi:type="uml:Association">
                     <name>Descriptor_identifies_ReferenceVariable</name>
                     <ownedEnd xmi:id="cdi.Descriptor_identifies_ReferenceVariable-ownedEnd-Descriptor"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_identifies_ReferenceVariable-ownedEnd-Descriptor"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.Descriptor"/>
                        <lowerValue xmi:id="cdi.Descriptor_identifies_ReferenceVariable-ownedEnd-Descriptor-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_identifies_ReferenceVariable-ownedEnd-Descriptor-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.Descriptor_identifies_ReferenceVariable-ownedEnd-Descriptor-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_identifies_ReferenceVariable-ownedEnd-Descriptor-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.Descriptor_identifies_ReferenceVariable"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.Descriptor-ownedAttribute-2"/>
                     <memberEnd xmi:idref="cdi.identifies-ownedEnd-Descriptor"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.Descriptor_hasValueFrom_DescriptorValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_hasValueFrom_DescriptorValueDomain"
                                    xmi:type="uml:Association">
                     <name>Descriptor_hasValueFrom_DescriptorValueDomain</name>
                     <ownedEnd xmi:id="cdi.Descriptor_hasValueFrom_DescriptorValueDomain-ownedEnd-Descriptor"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_hasValueFrom_DescriptorValueDomain-ownedEnd-Descriptor"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.Descriptor"/>
                        <lowerValue xmi:id="cdi.Descriptor_hasValueFrom_DescriptorValueDomain-ownedEnd-Descriptor-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_hasValueFrom_DescriptorValueDomain-ownedEnd-Descriptor-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.Descriptor_hasValueFrom_DescriptorValueDomain-ownedEnd-Descriptor-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor_hasValueFrom_DescriptorValueDomain-ownedEnd-Descriptor-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.Descriptor_hasValueFrom_DescriptorValueDomain"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.Descriptor-ownedAttribute-3"/>
                     <memberEnd xmi:idref="cdi.hasValueFrom-ownedEnd-Descriptor"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain"
                                    xmi:type="uml:Association">
                     <name>DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain</name>
                     <ownedEnd xmi:id="cdi.DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain-ownedEnd-DescriptorVariable"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain-ownedEnd-DescriptorVariable"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.DescriptorVariable"/>
                        <lowerValue xmi:id="cdi.DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain-ownedEnd-DescriptorVariable-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain-ownedEnd-DescriptorVariable-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain-ownedEnd-DescriptorVariable-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain-ownedEnd-DescriptorVariable-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.DescriptorVariable-ownedAttribute-1"/>
                     <memberEnd xmi:idref="cdi.takesSubstantiveValuesFrom-ownedEnd-DescriptorVariable"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ReferenceValue_hasValueFrom_ReferenceValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue_hasValueFrom_ReferenceValueDomain"
                                    xmi:type="uml:Association">
                     <name>ReferenceValue_hasValueFrom_ReferenceValueDomain</name>
                     <ownedEnd xmi:id="cdi.ReferenceValue_hasValueFrom_ReferenceValueDomain-ownedEnd-ReferenceValue"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue_hasValueFrom_ReferenceValueDomain-ownedEnd-ReferenceValue"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceValue"/>
                        <lowerValue xmi:id="cdi.ReferenceValue_hasValueFrom_ReferenceValueDomain-ownedEnd-ReferenceValue-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue_hasValueFrom_ReferenceValueDomain-ownedEnd-ReferenceValue-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.ReferenceValue_hasValueFrom_ReferenceValueDomain-ownedEnd-ReferenceValue-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue_hasValueFrom_ReferenceValueDomain-ownedEnd-ReferenceValue-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.ReferenceValue_hasValueFrom_ReferenceValueDomain"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.ReferenceValue-ownedAttribute-2"/>
                     <memberEnd xmi:idref="cdi.hasValueFrom-ownedEnd-ReferenceValue"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable_takesValuesFrom_ReferenceValueDomain"
                                    xmi:type="uml:Association">
                     <ownedComment xmi:id="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Points to a value domain that contains values that may be drawn from the domains of multiple simple variables.
</body>
                        <annotatedElement xmi:idref="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain"/>
                     </ownedComment>
                     <name>ReferenceVariable_takesValuesFrom_ReferenceValueDomain</name>
                     <ownedEnd xmi:id="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedEnd-ReferenceVariable"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedEnd-ReferenceVariable"
                                xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceVariable"/>
                        <lowerValue xmi:id="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedEnd-ReferenceVariable-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedEnd-ReferenceVariable-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <upperValue xmi:id="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedEnd-ReferenceVariable-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable_takesValuesFrom_ReferenceValueDomain-ownedEnd-ReferenceVariable-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain"/>
                     </ownedEnd>
                     <memberEnd xmi:idref="cdi.ReferenceVariable-ownedAttribute-1"/>
                     <memberEnd xmi:idref="cdi.takesValuesFrom-ownedEnd-ReferenceVariable"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.Descriptor"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.Descriptor-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
==========
Use of a code for variable identification in the context of a data structure and a variable descriptor component.

Examples
========
Consider two variables, i.e. income and age, with values appearing in the same column. Codes "income" and "age" are descriptors. They appear multiple time in a variable descriptor component, one for each value in the variable value component. Each descriptor references one of those values. This way it's possible to identify which values correspond to income and which ones to age.</body>
                        <annotatedElement xmi:idref="cdi.Descriptor"/>
                     </ownedComment>
                     <name>Descriptor</name>
                     <generalization xmi:id="cdi.Descriptor-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.KeyMember"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.Descriptor-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceValue"/>
                        <upperValue xmi:id="cdi.Descriptor-ownedAttribute-1-upperValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor-ownedAttribute-1-upperValue"
                                     xmi:type="uml:LiteralUnlimitedNatural">
                           <value>*</value>
                        </upperValue>
                        <association xmi:idref="cdi.Descriptor_refersTo_ReferenceValue"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.Descriptor-ownedAttribute-2"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor-ownedAttribute-2"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceVariable"/>
                        <association xmi:idref="cdi.Descriptor_identifies_ReferenceVariable"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.Descriptor-ownedAttribute-3"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Descriptor-ownedAttribute-3"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.DescriptorValueDomain"/>
                        <association xmi:idref="cdi.Descriptor_hasValueFrom_DescriptorValueDomain"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DescriptorValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorValueDomain"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DescriptorValueDomain-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorValueDomain-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Set of permissible values for a variable playing the role of a variable descriptor component.

Examples
==========
Consider two variables, i.e. income and age, with values appearing in the same column. 
Codes "income" and "age" are descriptors that appear in the descriptor value domain corresponding to the descriptor variable.

</body>
                        <annotatedElement xmi:idref="cdi.DescriptorValueDomain"/>
                     </ownedComment>
                     <name>DescriptorValueDomain</name>
                     <generalization xmi:id="cdi.DescriptorValueDomain-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorValueDomain-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.SubstantiveValueDomain"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.DescriptorVariable"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.DescriptorVariable-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Variable that provides codes for variable identification in the context of a data structure.
Variable playing the role of a variable descriptor component.

Examples
==========
Consider two variables, i.e. income and age, with values apearing in the same column. 
Codes "income" and "age" are descriptors that appear in the descriptor value domain corresponding to the descriptor variable.</body>
                        <annotatedElement xmi:idref="cdi.DescriptorVariable"/>
                     </ownedComment>
                     <name>DescriptorVariable</name>
                     <generalization xmi:id="cdi.DescriptorVariable-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.InstanceVariable"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.DescriptorVariable-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.DescriptorValueDomain"/>
                        <lowerValue xmi:id="cdi.DescriptorVariable-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DescriptorVariable-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.LongDataSet"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongDataSet"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.LongDataSet-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongDataSet-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Organized collection of long data. It is structured by a long data structure.

Examples
==========
A unit dataset where each row corresponds to a set of data points capturing different characteristics of a unit, some of which can be transposed into variable descriptor and variable value components.</body>
                        <annotatedElement xmi:idref="cdi.LongDataSet"/>
                     </ownedComment>
                     <name>LongDataSet</name>
                     <generalization xmi:id="cdi.LongDataSet-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongDataSet-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataSet"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.LongDataStructure"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongDataStructure"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.LongDataStructure-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongDataStructure-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Structure of a long dataset (organized collection of long data). It is described by identifier, measure, attribute, variable descriptor and variable value components.

Examples
==========
The structure described by [Unit id, Income, Province, Variable name, Variable value] where Unit id identifies a statistical unit, Income and Province are two instance variables capturing characteristics, and other instance variables are represented by Variable name (a variable descriptor component) and Variable Value (a variable value component).

</body>
                        <annotatedElement xmi:idref="cdi.LongDataStructure"/>
                     </ownedComment>
                     <name>LongDataStructure</name>
                     <generalization xmi:id="cdi.LongDataStructure-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongDataStructure-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataStructure"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.LongKey"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongKey"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.LongKey-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongKey-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Collection of data instances that uniquely identify a collection of data points in a long dataset.

Examples
==========
Collection containing the single "K1Z1C1" string in a long dataset where rows are identified by postal code representations.

</body>
                        <annotatedElement xmi:idref="cdi.LongKey"/>
                     </ownedComment>
                     <name>LongKey</name>
                     <generalization xmi:id="cdi.LongKey-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongKey-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.Key"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.LongMainKeyMember"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongMainKeyMember"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.LongMainKeyMember-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongMainKeyMember-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Single data instance that is part of a long key. 

Examples
==========
The "K1Z1C1" string in a long dataset where rows are identified by postal code representations.

</body>
                        <annotatedElement xmi:idref="cdi.LongMainKeyMember"/>
                     </ownedComment>
                     <name>LongMainKeyMember</name>
                     <generalization xmi:id="cdi.LongMainKeyMember-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LongMainKeyMember-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.KeyMember"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ReferenceValue"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.ReferenceValue-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Recorded value in a variable value component. 
Value referenced by a descriptor.

Examples
==========
Consider two variables, i.e. income and age, with values appearing in the same column, e.g. 100000, 45, 85000, 34, etc. 
Codes "income" and "age" are descriptors whereas 100000, 45, 85000, 34 are reference values.
</body>
                        <annotatedElement xmi:idref="cdi.ReferenceValue"/>
                     </ownedComment>
                     <name>ReferenceValue</name>
                     <generalization xmi:id="cdi.ReferenceValue-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.InstanceValue"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.ReferenceValue-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.VariableValueComponent"/>
                        <association xmi:idref="cdi.ReferenceValue_correspondsTo_VariableValueComponent"/>
                     </ownedAttribute>
                     <ownedAttribute xmi:id="cdi.ReferenceValue-ownedAttribute-2"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue-ownedAttribute-2"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceValueDomain"/>
                        <association xmi:idref="cdi.ReferenceValue_hasValueFrom_ReferenceValueDomain"/>
                     </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ReferenceValueDomain"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValueDomain"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.ReferenceValueDomain-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValueDomain-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Set of permissible values for a variable playing the role of a variable value component.

Examples
==========
Consider two variables, i.e. income and age, with values appearing in the same column. A reference variable in this case would be a type of represented variable that can take on values from both income and age. A long data structure might have a column that takes on values from this reference variable. A descriptor variable would then have values paired with the values from the reference variable, pointing to either the income or age variable.
</body>
                        <annotatedElement xmi:idref="cdi.ReferenceValueDomain"/>
                     </ownedComment>
                     <name>ReferenceValueDomain</name>
                     <generalization xmi:id="cdi.ReferenceValueDomain-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValueDomain-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.ValueDomain"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ReferenceVariable"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.ReferenceVariable-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Variable that records values of multiple variables in the context of a data structure.
Variable playing the role of a variable value component.

Examples
==========
Consider two variables, i.e. income and age, with values appearing in the same column, e.g. 100000, 45, 85000, 34, etc. 
Values 100000, 45, 85000, 34 are reference values in the reference value domain corresponding to the reference variable.

</body>
                        <annotatedElement xmi:idref="cdi.ReferenceVariable"/>
                     </ownedComment>
                     <name>ReferenceVariable</name>
                     <generalization xmi:id="cdi.ReferenceVariable-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.InstanceVariable"/>
                     </generalization>
                     <ownedAttribute xmi:id="cdi.ReferenceVariable-ownedAttribute-1"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable-ownedAttribute-1"
                                      xmi:type="uml:Property">
                        <isReadOnly>true</isReadOnly>
                        <type xmi:idref="cdi.ReferenceValueDomain"/>
                        <lowerValue xmi:id="cdi.ReferenceVariable-ownedAttribute-1-lowerValue"
                                     xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceVariable-ownedAttribute-1-lowerValue"
                                     xmi:type="uml:LiteralInteger">
                           <value>0</value>
                        </lowerValue>
                        <association xmi:idref="cdi.ReferenceVariable_takesValuesFrom_ReferenceValueDomain"/>
                     </ownedAttribute>
                  </packagedElement>
               </packagedElement>
               <packagedElement xmi:id="cdi.Wide"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Wide"
                                 xmi:type="uml:Package">
                  <ownedComment xmi:id="cdi.Wide-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Wide-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>This package contains classes for defining "rectangular" data files where each unit has a series of measurements recorded for it about a regular set of variables. (Although we often think of such data as existing in rows, logically it is independent of the specific formatting, and can be seen as a repeated cluster of measures across a set of units.) </body>
                     <annotatedElement xmi:idref="cdi.Wide"/>
                  </ownedComment>
                  <name>Wide</name>
                  <packagedElement xmi:id="cdi.WideDataSet"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideDataSet"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.WideDataSet-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideDataSet-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
============
Organized collection of wide data. It is structured by a wide data structure.

Examples
==========
A unit dataset where each row corresponds to a set of data points capturing different characteristics of a unit.

</body>
                        <annotatedElement xmi:idref="cdi.WideDataSet"/>
                     </ownedComment>
                     <name>WideDataSet</name>
                     <generalization xmi:id="cdi.WideDataSet-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideDataSet-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataSet"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.WideDataStructure"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideDataStructure"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.WideDataStructure-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideDataStructure-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
==========
Structure of a wide dataset (organized collection of wide data). It is described by identifier, measure and attribute components.

Examples
==========
The structure described by [Unit id, Income, Province] where Unit id identifies a statistical unit and Income and Province are two instance variables capturing characteristics.

</body>
                        <annotatedElement xmi:idref="cdi.WideDataStructure"/>
                     </ownedComment>
                     <name>WideDataStructure</name>
                     <generalization xmi:id="cdi.WideDataStructure-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideDataStructure-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.DataStructure"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.WideKey"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideKey"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.WideKey-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideKey-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition
==========
Collection of data instances that uniquely identify a collection of data points in a wide dataset.

Examples
==========
Collection containing the single "1A2B3C" string in a wide dataset where rows are identified by postal code representations.</body>
                        <annotatedElement xmi:idref="cdi.WideKey"/>
                     </ownedComment>
                     <name>WideKey</name>
                     <generalization xmi:id="cdi.WideKey-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideKey-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.Key"/>
                     </generalization>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.WideKeyMember"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideKeyMember"
                                    xmi:type="uml:Class">
                     <ownedComment xmi:id="cdi.WideKeyMember-ownedComment"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideKeyMember-ownedComment"
                                    xmi:type="uml:Comment">
                        <body>Definition 
============ 
Single data instance that is part of a wide key.   

Examples 
========== 
The "1A2B3C" string in a wide dataset where rows are identified by postal code representations.</body>
                        <annotatedElement xmi:idref="cdi.WideKeyMember"/>
                     </ownedComment>
                     <name>WideKeyMember</name>
                     <generalization xmi:id="cdi.WideKeyMember-generalization"
                                      xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WideKeyMember-generalization"
                                      xmi:type="uml:Generalization">
                        <general xmi:idref="cdi.KeyMember"/>
                     </generalization>
                  </packagedElement>
               </packagedElement>
            </packagedElement>
            <packagedElement xmi:id="cdi.FormatDescription"
                              xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#FormatDescription"
                              xmi:type="uml:Package">
               <ownedComment xmi:id="cdi.FormatDescription-ownedComment"
                              xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#FormatDescription-ownedComment"
                              xmi:type="uml:Comment">
                  <body>This package contains classes for tying the logical constructs in various data descriptions to physical formats.</body>
                  <annotatedElement xmi:idref="cdi.FormatDescription"/>
               </ownedComment>
               <name>FormatDescription</name>
               <packagedElement xmi:id="cdi.DataPointRelationship_refines_MemberRelationship"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#DataPointRelationship_refines_MemberRelationship"
                                 xmi:type="uml:Abstraction">
                  <name>DataPointRelationship_refines_MemberRelationship</name>
                  <client xmi:idref="cdi.DataPointRelationship"/>
                  <supplier xmi:idref="cdim.MemberRelationship"/>
               </packagedElement>
               <packagedElement xmi:id="cdi.InstanceVariableMap_refines_Map"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap_refines_Map"
                                 xmi:type="uml:Abstraction">
                  <name>InstanceVariableMap_refines_Map</name>
                  <client xmi:idref="cdi.InstanceVariableMap"/>
                  <supplier xmi:idref="cdim.Map"/>
               </packagedElement>
               <packagedElement xmi:id="cdi.LogicalRecord_refines_Collection"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LogicalRecord_refines_Collection"
                                 xmi:type="uml:Abstraction">
                  <name>LogicalRecord_refines_Collection</name>
                  <client xmi:idref="cdi.LogicalRecord"/>
                  <supplier xmi:idref="cdim.Collection"/>
               </packagedElement>
               <packagedElement xmi:id="cdi.LogicalRecordRelationship_refines_MemberRelationship"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LogicalRecordRelationship_refines_MemberRelationship"
                                 xmi:type="uml:Abstraction">
                  <name>LogicalRecordRelationship_refines_MemberRelationship</name>
                  <client xmi:idref="cdi.LogicalRecordRelationship"/>
                  <supplier xmi:idref="cdim.MemberRelationship"/>
               </packagedElement>
               <packagedElement xmi:id="cdi.LogicalRecordRepository_refines_Collection"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LogicalRecordRepository_refines_Collection"
                                 xmi:type="uml:Abstraction">
                  <name>LogicalRecordRepository_refines_Collection</name>
                  <client xmi:idref="cdi.LogicalRecordRepository"/>
                  <supplier xmi:idref="cdim.Collection"/>
               </packagedElement>
               <packagedElement xmi:id="cdi.LogicalRecordRepositoryStructure_refines_Structure"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LogicalRecordRepositoryStructure_refines_Structure"
                                 xmi:type="uml:Abstraction">
                  <name>LogicalRecordRepositoryStructure_refines_Structure</name>
                  <client xmi:idref="cdi.LogicalRecordRepositoryStructure"/>
                  <supplier xmi:idref="cdim.Structure"/>
               </packagedElement>
               <packagedElement xmi:id="cdi.PhysicalDataSet_refines_List"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#PhysicalDataSet_refines_List"
                                 xmi:type="uml:Abstraction">
                  <name>PhysicalDataSet_refines_List</name>
                  <client xmi:idref="cdi.PhysicalDataSet"/>
                  <supplier xmi:idref="cdim.List"/>

                     <lowerValue xmi:id="cdi.AgentRelationship-identifier-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentRelationship-identifier-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.AgentRelationship-semantics"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentRelationship-semantics"
                                   xmi:type="uml:Property">

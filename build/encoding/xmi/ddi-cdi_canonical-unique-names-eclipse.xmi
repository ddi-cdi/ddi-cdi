                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-isTranslatable-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <defaultValue xmi:id="cdi.LanguageString-isTranslatable-defaultValue"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-isTranslatable-defaultValue"
                                    xmi:type="uml:LiteralBoolean">
                        <value>True</value>
                     </defaultValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.LanguageString-isTranslated"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-isTranslated"
                                   xmi:type="uml:Property">
                     <name>isTranslated</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
                     <lowerValue xmi:id="cdi.LanguageString-isTranslated-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-isTranslated-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <defaultValue xmi:id="cdi.LanguageString-isTranslated-defaultValue"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-isTranslated-defaultValue"
                                    xmi:type="uml:LiteralBoolean">
                        <value>False</value>
                     </defaultValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.LanguageString-language"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-language"
                                   xmi:type="uml:Property">
                     <name>language</name>
                     <type xmi:idref="cdi.XsdLanguage"/>
                     <lowerValue xmi:id="cdi.LanguageString-language-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#LanguageString-language-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>

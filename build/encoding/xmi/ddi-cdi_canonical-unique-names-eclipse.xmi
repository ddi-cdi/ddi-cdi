                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.Address-countryCode-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Address-countryCode-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>

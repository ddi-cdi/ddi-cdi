                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.ControlLogic-ownedAttribute-8-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ControlLogic-ownedAttribute-8-upperValue"

                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.WebLink-isPreferred"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WebLink-isPreferred"
                                   xmi:type="uml:Property">
                     <name>isPreferred</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
                     <lowerValue xmi:id="cdi.WebLink-isPreferred-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#WebLink-isPreferred-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <defaultValue xmi:id="cdi.WebLink-isPreferred-defaultValue"

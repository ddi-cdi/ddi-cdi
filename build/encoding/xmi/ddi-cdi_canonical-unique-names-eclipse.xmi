                                   xmi:type="uml:Property">
                     <name>typeOfTelephone</name>
                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.Telephone-typeOfTelephone-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Telephone-typeOfTelephone-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>

                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ValueAndConceptDescription-maximumValueExclusive"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ValueAndConceptDescription-maximumValueExclusive"
                                   xmi:type="uml:Property">
                     <name>maximumValueExclusive</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
                     <lowerValue xmi:id="cdi.ValueAndConceptDescription-maximumValueExclusive-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ValueAndConceptDescription-maximumValueExclusive-lowerValue"

               <packagedElement xmi:id="cdi.Telephone"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Telephone"
                                 xmi:type="uml:DataType">
                  <ownedComment xmi:id="cdi.Telephone-ownedComment"

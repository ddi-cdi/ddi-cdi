                                 xmi:type="uml:EnumerationLiteral">
                     <name>Masculine</name>
                  </ownedLiteral>
               </packagedElement>
               <packagedElement xmi:id="cdi.StructureExtent"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#StructureExtent"
                                 xmi:type="uml:Enumeration">
                  <ownedComment xmi:id="cdi.StructureExtent-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#StructureExtent-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition
============
Type of relation in terms of totality with respect to an associated collection.  The totality type is given by the controlled vocabulary {total, partial}.

Examples
==========
A binary relation R on a collection C is total if all members of C are related to each other in R. The relation is partial otherwise.


</body>
                     <annotatedElement xmi:idref="cdi.StructureExtent"/>
                  </ownedComment>
                  <name>StructureExtent</name>
                  <ownedLiteral xmi:id="cdi.StructureExtent-Partial"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#StructureExtent-Partial"
                                 xmi:type="uml:EnumerationLiteral">
                     <name>Partial</name>
                  </ownedLiteral>
                  <ownedLiteral xmi:id="cdi.StructureExtent-Total"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#StructureExtent-Total"
                                 xmi:type="uml:EnumerationLiteral">
                     <name>Total</name>
                  </ownedLiteral>
               </packagedElement>
               <packagedElement xmi:id="cdi.TableDirectionValues"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#TableDirectionValues"
                                 xmi:type="uml:Enumeration">
                  <ownedComment xmi:id="cdi.TableDirectionValues-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#TableDirectionValues-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition
============
Indicates whether the tables in the group should be displayed with the first column on the right, on the left, or based on the first character in the table that has a specific direction.


</body>
                     <annotatedElement xmi:idref="cdi.TableDirectionValues"/>
                  </ownedComment>
                  <name>TableDirectionValues</name>
                  <ownedLiteral xmi:id="cdi.TableDirectionValues-Auto"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#TableDirectionValues-Auto"
                                 xmi:type="uml:EnumerationLiteral">
                     <name>Auto</name>
                  </ownedLiteral>
                  <ownedLiteral xmi:id="cdi.TableDirectionValues-Ltr"

               <packagedElement xmi:id="cdi.InstanceValue"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceValue"
                                 xmi:type="uml:Class">
                  <ownedComment xmi:id="cdi.InstanceValue-ownedComment"

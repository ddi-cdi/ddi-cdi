                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.AgentRelationship-identifier"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentRelationship-identifier"

                     </lowerValue>
                     <upperValue xmi:id="cdi.ControlLogic-displayLabel-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ControlLogic-displayLabel-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ControlLogic-identifier"

                  <ownedAttribute xmi:id="cdi.ClassificationSeriesStructure-ownedAttribute-8"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationSeriesStructure-ownedAttribute-8"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.ClassificationSeries"/>
                     <lowerValue xmi:id="cdi.ClassificationSeriesStructure-ownedAttribute-8-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationSeriesStructure-ownedAttribute-8-lowerValue"

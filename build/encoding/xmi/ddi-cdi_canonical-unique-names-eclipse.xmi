                               xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
               </ownedAttribute>
               <ownedAttribute xmi:id="rdf.langString-lexicalForm"
                                xmi:uuid="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString-lexicalForm"
                                xmi:type="uml:Property">
                  <name>lexicalForm</name>
                  <type xmi:type="uml:PrimitiveType"
                         href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="rdf.PackageInformation"
                              xmi:uuid="http://www.w3.org/1999/02/22-rdf-syntax-ns#PackageInformation"
                              xmi:type="uml:DataType">
               <name>PackageInformation</name>
               <ownedAttribute xmi:id="rdf.PackageInformation-prefix"

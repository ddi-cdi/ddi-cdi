                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.ConceptSystem"/>
                     <lowerValue xmi:id="cdi.ConceptualDomain-ownedAttribute-5-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualDomain-ownedAttribute-5-lowerValue"

                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.AgentInRole-reference"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#AgentInRole-reference"

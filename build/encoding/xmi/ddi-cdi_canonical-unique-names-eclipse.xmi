                        <value>*</value>
                     </upperValue>
                     <association xmi:idref="cdi.ConceptMap_hasSource_Concept"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ConceptMap-ownedAttribute-7"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptMap-ownedAttribute-7"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.Concept"/>
                     <upperValue xmi:id="cdi.ConceptMap-ownedAttribute-7-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptMap-ownedAttribute-7-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                     <association xmi:idref="cdi.ConceptMap_hasTarget_Concept"/>

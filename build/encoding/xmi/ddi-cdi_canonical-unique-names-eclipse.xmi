                               xmi:uuid="DDICDIModels#Map-ownedAttribute-2-lowerValue"
                               xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="cdim.Map-ownedAttribute-2-upperValue"
                               xmi:uuid="DDICDIModels#Map-ownedAttribute-2-upperValue"
                               xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <association xmi:idref="cdim.Map_hasTarget_Member"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="cdim.Map-ownedAttribute-3"
                                xmi:uuid="DDICDIModels#Map-ownedAttribute-3"
                                xmi:type="uml:Property">
                  <isReadOnly>true</isReadOnly>
                  <type xmi:idref="cdim.Member"/>
                  <lowerValue xmi:id="cdim.Map-ownedAttribute-3-lowerValue"

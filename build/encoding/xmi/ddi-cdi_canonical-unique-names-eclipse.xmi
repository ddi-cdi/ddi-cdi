                     <lowerValue xmi:id="cdi.ValueAndConceptDescription-identifier-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ValueAndConceptDescription-identifier-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>

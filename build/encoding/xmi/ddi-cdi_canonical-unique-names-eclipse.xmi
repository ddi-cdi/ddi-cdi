                  <ownedComment xmi:id="cdi.CategoryStatistics-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#CategoryStatistics-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition 
============ 
Statistics related to a specific category of an instance variable within a data set.  

Examples 
========== 
The percentage of females from a demographic data set.   

</body>
                     <annotatedElement xmi:idref="cdi.CategoryStatistics"/>
                  </ownedComment>
                  <name>CategoryStatistics</name>
                  <generalization xmi:id="cdi.CategoryStatistics-generalization"

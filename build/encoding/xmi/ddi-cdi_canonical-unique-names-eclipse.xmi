                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ConceptMap-ownedAttribute-6"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptMap-ownedAttribute-6"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.Concept"/>

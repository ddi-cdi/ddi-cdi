                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Datum-catalogDetails-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.Datum-identifier"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Datum-identifier"
                                   xmi:type="uml:Property">
                     <name>identifier</name>

                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Address-cityPlaceLocal-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.Address-countryCode"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Address-countryCode"
                                   xmi:type="uml:Property">

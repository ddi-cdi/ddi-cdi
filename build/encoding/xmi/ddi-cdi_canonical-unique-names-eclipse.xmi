                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.ControlLogic-ownedAttribute-9-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ControlLogic-ownedAttribute-9-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                     <association xmi:idref="cdi.InformationFlowDefinition_has_ControlLogic"/>

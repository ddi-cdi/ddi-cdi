                        <value>0</value>
                     </lowerValue>
                     <association xmi:idref="cdi.ClassificationSeriesStructure_structures_ClassificationSeries"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ClassificationSeriesStructure-ownedAttribute-9"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationSeriesStructure-ownedAttribute-9"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.StatisticalClassificationRelationship"/>
                     <lowerValue xmi:id="cdi.ClassificationSeriesStructure-ownedAttribute-9-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationSeriesStructure-ownedAttribute-9-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.ClassificationSeriesStructure-ownedAttribute-9-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationSeriesStructure-ownedAttribute-9-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">

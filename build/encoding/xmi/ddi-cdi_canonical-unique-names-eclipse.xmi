               <packagedElement xmi:id="cdi.InstanceVariableMap"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap"
                                 xmi:type="uml:Class">
                  <ownedComment xmi:id="cdi.InstanceVariableMap-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition 
============ 
Key value relationship for two or more logical records where the key is one or more equivalent instance variables and the value is a defined relationship or a relationship to a set value.  

Explanatory notes 
=================== 
The instance variable map identifies the variables which are used to connect two data sets, as when persons in one structure are associated with households in another structure. For logical records Household and Person, the keys are Household ID (HHID in Household Record), and Person ID (HHIDP in Person Record). Their value relationship is Equal, and set value is n.a. For each person in the person record, the value of HHIDP will be exactly the same as the value of HHID in the household record for the household to which they belong. (Correspondence type refers to the variables themselves rather than the value of the variables concerned.) In this context correspondence type will normally be set to ExactMatch.</body>
                     <annotatedElement xmi:idref="cdi.InstanceVariableMap"/>
                  </ownedComment>
                  <name>InstanceVariableMap</name>
                  <ownedAttribute xmi:id="cdi.InstanceVariableMap-comparison"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-comparison"
                                   xmi:type="uml:Property">
                     <name>comparison</name>
                     <type xmi:idref="cdi.ComparisonOperator"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariableMap-correspondence"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-correspondence"
                                   xmi:type="uml:Property">
                     <name>correspondence</name>
                     <type xmi:idref="cdi.CorrespondenceDefinition"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariableMap-identifier"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-identifier"
                                   xmi:type="uml:Property">
                     <name>identifier</name>
                     <type xmi:idref="cdi.Identifier"/>
                     <lowerValue xmi:id="cdi.InstanceVariableMap-identifier-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-identifier-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariableMap-setValue"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-setValue"
                                   xmi:type="uml:Property">
                     <name>setValue</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariableMap-ownedAttribute-5"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-ownedAttribute-5"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.InstanceVariable"/>
                     <lowerValue xmi:id="cdi.InstanceVariableMap-ownedAttribute-5-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-ownedAttribute-5-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.InstanceVariableMap-ownedAttribute-5-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-ownedAttribute-5-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                     <association xmi:idref="cdi.InstanceVariableMap_hasTarget_InstanceVariable"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariableMap-ownedAttribute-6"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-ownedAttribute-6"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.InstanceVariable"/>
                     <upperValue xmi:id="cdi.InstanceVariableMap-ownedAttribute-6-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariableMap-ownedAttribute-6-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                     <association xmi:idref="cdi.InstanceVariableMap_hasSource_InstanceVariable"/>
                  </ownedAttribute>
               </packagedElement>

                                   xmi:type="uml:Generalization">
                     <general xmi:idref="cdi.Statistics"/>
                  </generalization>
                  <ownedAttribute xmi:id="cdi.CategoryStatistics-ownedAttribute-1"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#CategoryStatistics-ownedAttribute-1"

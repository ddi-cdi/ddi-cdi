                                   xmi:type="uml:Property">
                     <name>isInclusive</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
                     <lowerValue xmi:id="cdi.Universe-isInclusive-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Universe-isInclusive-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <defaultValue xmi:id="cdi.Universe-isInclusive-defaultValue"

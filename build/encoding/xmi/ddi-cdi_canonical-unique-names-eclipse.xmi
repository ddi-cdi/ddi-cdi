                                   xmi:type="uml:Property">
                     <name>identifier</name>
                     <type xmi:idref="cdi.Identifier"/>
                     <lowerValue xmi:id="cdi.ControlLogic-identifier-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ControlLogic-identifier-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ControlLogic-name"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ControlLogic-name"
                                   xmi:type="uml:Property">

                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#BibliographicName-affiliation-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
               </packagedElement>

                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ObjectAttributeSelector-refinedByOrderNumber"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ObjectAttributeSelector-refinedByOrderNumber"
                                   xmi:type="uml:Property">
                     <name>refinedByOrderNumber</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
                     <lowerValue xmi:id="cdi.ObjectAttributeSelector-refinedByOrderNumber-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ObjectAttributeSelector-refinedByOrderNumber-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ObjectAttributeSelector-value"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ObjectAttributeSelector-value"
                                   xmi:type="uml:Property">
                     <name>value</name>
                     <type xmi:type="uml:PrimitiveType"
                            href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
                     <lowerValue xmi:id="cdi.ObjectAttributeSelector-value-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ObjectAttributeSelector-value-lowerValue"

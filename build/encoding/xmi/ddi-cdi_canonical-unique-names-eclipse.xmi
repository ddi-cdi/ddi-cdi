                  <body>Definition
==========
The datatype of language-tagged string values. Defined according to the data type langString in RDF, see https://www.w3.org/TR/rdf-schema/#ch_langstring and https://www.w3.org/1999/02/22-rdf-syntax-ns#langString.</body>
                  <annotatedElement xmi:idref="rdf.langString"/>
               </ownedComment>
               <name>langString</name>
               <ownedAttribute xmi:id="rdf.langString-language"
                                xmi:uuid="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString-language"
                                xmi:type="uml:Property">
                  <name>language</name>
                  <type xmi:type="uml:PrimitiveType"
                         href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
                  <lowerValue xmi:id="rdf.langString-language-lowerValue"

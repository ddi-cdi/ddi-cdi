                     <memberEnd xmi:idref="cdi.refersTo-ownedEnd-VariableDescriptorComponent"/>
                  </packagedElement>
                  <packagedElement xmi:id="cdi.ReferenceValue_correspondsTo_VariableValueComponent"
                                    xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue_correspondsTo_VariableValueComponent"
                                    xmi:type="uml:Association">
                     <name>ReferenceValue_correspondsTo_VariableValueComponent</name>
                     <ownedEnd xmi:id="cdi.ReferenceValue_correspondsTo_VariableValueComponent-ownedEnd-ReferenceValue"
                                xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ReferenceValue_correspondsTo_VariableValueComponent-ownedEnd-ReferenceValue"

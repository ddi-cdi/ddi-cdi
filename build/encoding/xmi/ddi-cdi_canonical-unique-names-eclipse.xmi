                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-unitOfMeasureKind-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ConceptualVariable-ownedAttribute-3"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualVariable-ownedAttribute-3"

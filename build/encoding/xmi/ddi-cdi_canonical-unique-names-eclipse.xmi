                     <type xmi:idref="cdi.CatalogDetails"/>
                     <lowerValue xmi:id="cdi.ClassificationIndexEntry-catalogDetails-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationIndexEntry-catalogDetails-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.ClassificationIndexEntry-codingInstruction"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ClassificationIndexEntry-codingInstruction"

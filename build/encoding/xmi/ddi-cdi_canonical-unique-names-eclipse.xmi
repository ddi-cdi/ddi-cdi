                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                  </ownedAttribute>
               </packagedElement>
            </packagedElement>
            <packagedElement xmi:id="cdi.Conceptual"
                              xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Conceptual"

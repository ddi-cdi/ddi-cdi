                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#CategoryStatistics-ownedAttribute-1-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <association xmi:idref="cdi.CategoryStatistics_for_Category"/>
                  </ownedAttribute>
               </packagedElement>
               <packagedElement xmi:id="cdi.ConceptualValue"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualValue"
                                 xmi:type="uml:Class">
                  <ownedComment xmi:id="cdi.ConceptualValue-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualValue-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition 
============ 
Concept (with a notion of equality defined) being observed, captured, or derived which is associated to a single data instance.   

Examples 
========== 
A systolic blood pressure of 122 is measured. The instance value for that measurement in this paragraph is the character string "122". The associated measured concept (a blood pressure at that level) is the conceptual value.  The conceptual value comes from a conceptual domain associated with a conceptual variable.   

Explanatory notes 
=================== 
This is the concept associated to the actual instance of data that is stored in a data point (the signified of a datum in the signification pattern).</body>
                     <annotatedElement xmi:idref="cdi.ConceptualValue"/>
                  </ownedComment>
                  <name>ConceptualValue</name>
                  <generalization xmi:id="cdi.ConceptualValue-generalization"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualValue-generalization"
                                   xmi:type="uml:Generalization">
                     <general xmi:idref="cdi.Concept"/>
                  </generalization>
                  <ownedAttribute xmi:id="cdi.ConceptualValue-ownedAttribute-1"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#ConceptualValue-ownedAttribute-1"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.ConceptualDomain"/>
                     <association xmi:idref="cdi.ConceptualValue_hasConceptFrom_ConceptualDomain"/>
                  </ownedAttribute>
               </packagedElement>

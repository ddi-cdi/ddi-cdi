                     <lowerValue xmi:id="cdi.Concept-ownedAttribute-7-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Concept-ownedAttribute-7-lowerValue"

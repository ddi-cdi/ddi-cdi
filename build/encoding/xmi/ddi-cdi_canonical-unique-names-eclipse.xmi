                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="cdim.Sign_denotes_Signified-ownedEnd-Sign-upperValue"
                               xmi:uuid="DDICDIModels#Sign_denotes_Signified-ownedEnd-Sign-upperValue"
                               xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>

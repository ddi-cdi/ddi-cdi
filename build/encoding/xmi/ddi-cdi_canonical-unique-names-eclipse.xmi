                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariable-physicalDataType"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-physicalDataType"
                                   xmi:type="uml:Property">
                     <name>physicalDataType</name>
                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.InstanceVariable-physicalDataType-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-physicalDataType-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariable-platformType"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-platformType"
                                   xmi:type="uml:Property">
                     <name>platformType</name>
                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.InstanceVariable-platformType-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-platformType-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariable-role"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-role"
                                   xmi:type="uml:Property">
                     <name>role</name>
                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.InstanceVariable-role-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-role-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.InstanceVariable-role-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-role-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariable-source"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-source"
                                   xmi:type="uml:Property">
                     <name>source</name>
                     <type xmi:idref="cdi.Reference"/>
                     <lowerValue xmi:id="cdi.InstanceVariable-source-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-source-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.InstanceVariable-ownedAttribute-6"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-ownedAttribute-6"
                                   xmi:type="uml:Property">
                     <type xmi:idref="cdi.StatisticsCollection"/>
                     <lowerValue xmi:id="cdi.InstanceVariable-ownedAttribute-6-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#InstanceVariable-ownedAttribute-6-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <association xmi:idref="cdi.InstanceVariable_isDescribedBy_StatisticsCollection"/>
                  </ownedAttribute>
               </packagedElement>
               <packagedElement xmi:id="cdi.Population"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population"
                                 xmi:type="uml:Class">
                  <ownedComment xmi:id="cdi.Population-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition
============
Universe with time and geography specified.

Examples
==========
1. Canadian adult persons residing in Canada on 13 November 1956.
2. US computer companies at the end of 2012.  
3. Universities in Denmark 1 January 2011.

Explanatory notes
===================
Population is the most specific in the conceptually narrowing hierarchy of unit type, universe and population. Several populations having differing time and or geography may specialize the same universe.</body>
                     <annotatedElement xmi:idref="cdi.Population"/>
                  </ownedComment>
                  <name>Population</name>
                  <generalization xmi:id="cdi.Population-generalization"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-generalization"
                                   xmi:type="uml:Generalization">
                     <general xmi:idref="cdi.Universe"/>
                  </generalization>
                  <ownedAttribute xmi:id="cdi.Population-timePeriodOfPopulation"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-timePeriodOfPopulation"
                                   xmi:type="uml:Property">
                     <name>timePeriodOfPopulation</name>
                     <type xmi:idref="cdi.DateRange"/>
                     <lowerValue xmi:id="cdi.Population-timePeriodOfPopulation-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-timePeriodOfPopulation-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.Population-timePeriodOfPopulation-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-timePeriodOfPopulation-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.Population-ownedAttribute-2"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-ownedAttribute-2"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
                     <type xmi:idref="cdi.Unit"/>
                     <lowerValue xmi:id="cdi.Population-ownedAttribute-2-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-ownedAttribute-2-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <upperValue xmi:id="cdi.Population-ownedAttribute-2-upperValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Population-ownedAttribute-2-upperValue"
                                  xmi:type="uml:LiteralUnlimitedNatural">
                        <value>*</value>
                     </upperValue>
                     <association xmi:idref="cdi.Population_isComposedOf_Unit"/>
                     <aggregation>shared</aggregation>
                  </ownedAttribute>
               </packagedElement>
               <packagedElement xmi:id="cdi.RepresentedVariable"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RepresentedVariable"
                                 xmi:type="uml:Class">
                  <ownedComment xmi:id="cdi.RepresentedVariable-ownedComment"
                                 xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RepresentedVariable-ownedComment"
                                 xmi:type="uml:Comment">
                     <body>Definition 
========== 
Conceptual variable with a substantive value domain specified.   

Examples 
========== 
The pair (Number of Employees, Integer), where "Number of Employees" is the characteristic of the population (variable) and "Integer" is how that measure will be represented (value domain).  

Explanatory notes 
=================== 
Extends from conceptual variable and can contain all descriptive fields without creating a conceptual variable. By referencing a conceptual variable it can indicate a common relationship with represented variables expressing the same characteristic of a universe measured in another way, such as Age of Persons in hours rather than years. Represented variable constrains the coverage of the unit type to a specific universe. In the above case the universe with the measurement of Age in hours may be constrained to Persons under 5 days (120 hours old). Represented variable can define sentinel values for multiple storage systems which have the same conceptual domain but specialized value domains.

</body>
                     <annotatedElement xmi:idref="cdi.RepresentedVariable"/>
                  </ownedComment>
                  <name>RepresentedVariable</name>
                  <generalization xmi:id="cdi.RepresentedVariable-generalization"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RepresentedVariable-generalization"
                                   xmi:type="uml:Generalization">
                     <general xmi:idref="cdi.ConceptualVariable"/>
                  </generalization>
                  <ownedAttribute xmi:id="cdi.RepresentedVariable-describedUnitOfMeasure"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RepresentedVariable-describedUnitOfMeasure"
                                   xmi:type="uml:Property">
                     <name>describedUnitOfMeasure</name>
                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>
                     <lowerValue xmi:id="cdi.RepresentedVariable-describedUnitOfMeasure-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RepresentedVariable-describedUnitOfMeasure-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.RepresentedVariable-hasIntendedDataType"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#RepresentedVariable-hasIntendedDataType"
                                   xmi:type="uml:Property">
                     <name>hasIntendedDataType</name>
                     <type xmi:idref="cdi.ControlledVocabularyEntry"/>

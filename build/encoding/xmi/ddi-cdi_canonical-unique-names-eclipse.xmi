                                   xmi:type="uml:Property">
                     <type xmi:idref="cdi.Notation"/>
                     <lowerValue xmi:id="cdi.Datum-ownedAttribute-3-lowerValue"
                                  xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Datum-ownedAttribute-3-lowerValue"
                                  xmi:type="uml:LiteralInteger">
                        <value>0</value>
                     </lowerValue>
                     <association xmi:idref="cdi.Datum_uses_Notation"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="cdi.Datum-ownedAttribute-4"
                                   xmi:uuid="https://www.ddialliance.org/Specification/DDI-CDI/1.0/#Datum-ownedAttribute-4"
                                   xmi:type="uml:Property">
                     <isReadOnly>true</isReadOnly>
